{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gemma Harness",
  "version": "0.3.5",
  "identifier": "dev.gemmaharness.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../../"
    },
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../../"
    },
    "frontendDist": "../../../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Gemma Harness",
        "width": 1480,
        "height": 940,
        "minWidth": 1050,
        "minHeight": 680,
        "backgroundColor": "#141615",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "A local-first coding and computer-use workbench for Gemma",
    "resources": {
      "../../../build/worker-resources/workers/": "workers/"
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "infoPlist": "Info.plist",
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "at-spi2-core",
          "xdg-desktop-portal",
          "pipewire",
          "gstreamer1.0-tools",
          "gstreamer1.0-pipewire",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "libgtk-3-bin"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY5NDgzNUEwMjlFQkEyMUYKUldRZm91c3BvRFZJYVpYajF2TVNlaVp0cGhvQ1BaQzY3SmFvTUxDZkhST0YxUitobWZMYXE4K2UK",
      "endpoints": [
        "https://raw.githubusercontent.com/superFRANK666/Gemma-Harness/update-channel/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
