{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-workbench",
  "description": "Local workbench IPC and user-selected file dialogs",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "updater:allow-check",
    "updater:allow-download",
    "updater:allow-install",
    "process:allow-restart"
  ]
}
